# Local .terraform directories
**/.terraform/*
**/.terraform/

# .tfstate files
*.tfstate
*.tfstate.*

# Crash log files
crash.log
crash.*.log

# Exclude all .tfvars files
*.tfvars
*.tfvars.json

# Ignore override files
override.tf
override.tf.json
*_override.tf
*_override.tf.json

# Ignore CLI configuration files
.terraformrc
terraform.rc

# Mac system files
.DS_Store

# Python
.venv/
__pycache__/
*.pyc

# Node
node_modules/
.next/

# Environment configurations (Secrets)
.env
.env.local
.env.*.local

# Docker volume
volume/
